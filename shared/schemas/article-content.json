{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "文章内容 (Article Content)",
  "description": "撰写阶段的最终产出：带完整引用标记的 Markdown 格式文章，可直接注入 HTML 模板。",
  "type": "object",
  "required": ["meta", "sections", "citations", "statistics"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["word", "options", "total_words", "generated_at"],
      "properties": {
        "word": { "type": "string" },
        "options": {
          "type": "object",
          "required": ["speed", "depth", "scope", "format", "illustrations", "tone", "citation_density", "language"],
          "properties": {
            "speed": { "type": "string", "enum": ["fast", "standard", "deep"] },
            "depth": { "type": "string", "enum": ["intro", "mid", "pro"] },
            "scope": { "type": "string", "enum": ["point", "related", "panorama"] },
            "format": { "type": "string", "enum": ["html", "markdown", "pdf"] },
            "illustrations": { "type": "boolean" },
            "tone": { "type": "string", "enum": ["popular", "academic", "editorial"] },
            "citation_density": { "type": "string", "enum": ["low", "standard", "high"] },
            "language": { "type": "string", "enum": ["zh", "en", "fr", "de", "ja", "ko", "ar", "es", "ru"] },
            "custom": { "type": "array", "items": { "type": "string" } }
          },
          "description": "统一配置面板（三轴档位 + 格式/配图/语气/引用密度/主题语言），见 shared/config/quality-gates.json"
        },
        "total_words": {
          "type": "integer",
          "minimum": 8000,
          "description": "硬性下限 = base_words(10,000) × depth.word_multiplier + scope.extra_words（最低 intro+point=8,000；shared/config/quality-gates.json）"
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "author_note": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 6,
      "description": "任何档位均为 6 阶；scope=related/panorama 时每阶附 related_sidebar",
      "items": {
        "type": "object",
        "required": ["stage", "title", "content", "word_count", "cached_terms"],
        "properties": {
          "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "content": {
            "type": "string",
            "description": "Markdown 格式的正文内容，引用使用 [N] 上标标记"
          },
          "word_count": { "type": "integer" },
          "cached_terms": {
            "type": "array",
            "description": "本阶需要 tooltip 的术语",
            "items": {
              "type": "object",
              "properties": {
                "term": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          },
          "related_sidebar": {
            "type": "array",
            "description": "scope=related/panorama 时的本阶关联概念侧栏（至少 1 条）",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "visual_assets": {
            "type": "object",
            "description": "本阶需要的可视化资源",
            "properties": {
              "type": { "type": "string", "enum": ["timeline", "cards", "flowchart", "comparison_table", "knowledge_graph", "none"] },
              "data": { "type": "object", "description": "可视化所需的结构化数据" }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "任何档位均为 5 个过渡问题",
      "items": {
        "type": "object",
        "properties": {
          "from_stage": { "type": "integer" },
          "to_stage": { "type": "integer" },
          "text": { "type": "string" }
        }
      }
    },
    "citations": {
      "type": "array",
      "description": "引用列表下限按 citation_density：low ≥6 / standard ≥8 / high ≥12（由根级 if/then 约束）",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string", "enum": ["academic", "official", "deep_content", "news", "encyclopedia"] },
          "title": { "type": "string" },
          "authors": { "type": "string" },
          "year": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "access_date": { "type": "string" },
          "relevance_note": { "type": "string", "description": "为什么引用此来源" }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "术语表：全文术语、一句话定义与首次出现阶；交付时渲染为术语表章节",
      "items": {
        "type": "object",
        "required": ["term", "definition", "first_stage"],
        "properties": {
          "term": { "type": "string" },
          "definition": { "type": "string" },
          "first_stage": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "total_words": { "type": "integer" },
        "words_per_stage": {
          "type": "object",
          "patternProperties": {
            "^stage_[1-6]$": { "type": "integer" }
          }
        },
        "total_citations": { "type": "integer" },
        "unique_sources": { "type": "integer" },
        "avg_sentence_length": { "type": "number" },
        "analogy_count": { "type": "integer" },
        "defined_terms_count": { "type": "integer" },
        "ai_pattern_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "AI 痕迹检测得分，<0.3 为合格"
        }
      }
    }
  },
  "extras": {
    "type": "object",
    "description": "scope=panorama 时的附加章节",
    "properties": {
      "panorama_intro": {
        "type": "string",
        "description": "开头「全景导览」：一句话定位 + 知识地图导语"
      },
      "further_reading": {
        "type": "array",
        "minItems": 5,
        "description": "结尾「知识地图/延伸阅读」：至少 5 条延伸资源",
        "items": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "options": {
                "properties": { "citation_density": { "const": "low" } },
                "required": ["citation_density"]
              }
            },
            "required": ["options"]
          }
        },
        "required": ["meta"]
      },
      "then": { "properties": { "citations": { "minItems": 6 } } }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "options": {
                "properties": { "citation_density": { "const": "standard" } },
                "required": ["citation_density"]
              }
            },
            "required": ["options"]
          }
        },
        "required": ["meta"]
      },
      "then": { "properties": { "citations": { "minItems": 8 } } }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "options": {
                "properties": { "citation_density": { "const": "high" } },
                "required": ["citation_density"]
              }
            },
            "required": ["options"]
          }
        },
        "required": ["meta"]
      },
      "then": { "properties": { "citations": { "minItems": 12 } } }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "options": {
                "properties": { "scope": { "const": "panorama" } },
                "required": ["scope"]
              }
            },
            "required": ["options"]
          }
        },
        "required": ["meta"]
      },
      "then": {
        "properties": {
          "extras": {
            "required": ["panorama_intro", "further_reading"]
          }
        },
        "required": ["extras"]
      }
    }
  ]
}
